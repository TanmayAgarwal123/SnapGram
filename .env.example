# SnapGram — Appwrite configuration
# Copy this file to `.env` and fill in the values from your Appwrite console
# (https://cloud.appwrite.io). Restart `npm run dev` after changing these.

# Appwrite API endpoint. Use the default below for Appwrite Cloud,
# or your own URL if you self-host (e.g. http://localhost/v1).
VITE_APPWRITE_URL=https://cloud.appwrite.io/v1

# Project settings → Project ID
VITE_APPWRITE_PROJECT_ID=

# Databases → your database → Database ID
VITE_APPWRITE_DATABASE_ID=

# Storage → your bucket → Bucket ID
VITE_APPWRITE_STORAGE_ID=

# Databases → Collections → Collection ID (one per collection)
VITE_APPWRITE_USER_COLLECTION_ID=
VITE_APPWRITE_POST_COLLECTION_ID=
VITE_APPWRITE_SAVES_COLLECTION_ID=

# New collections added by the upgrade (Phase 4 – social features).
# Leave blank until you create them; the app runs fine without them.
VITE_APPWRITE_COMMENTS_COLLECTION_ID=
VITE_APPWRITE_FOLLOWS_COLLECTION_ID=
VITE_APPWRITE_NOTIFICATIONS_COLLECTION_ID=
